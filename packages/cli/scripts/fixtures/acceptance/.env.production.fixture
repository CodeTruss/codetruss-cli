MODE="production"

# A Firebase WEB app config, exactly as excalidraw commits it: one JSON line,
# `apiKey` beside the config's other keys. Public by design — it is compiled
# into every browser bundle — and must NOT be reported as a committed credential.
VITE_APP_FIREBASE_CONFIG='{"apiKey":"AIzaSyD9tR2vQ6mHc0LwXbN4pKfE7uZa1sJ3oYt","authDomain":"acceptance-fixture.firebaseapp.com","projectId":"acceptance-fixture","storageBucket":"acceptance-fixture.appspot.com","messagingSenderId":"719204853166","appId":"1:719204853166:web:0b7c4d2e9a15f38cd6e441"}'

# A publishable client key with no Firebase config around it. The build tool
# inlines anything named VITE_*, so this is public to every visitor whatever the
# repository does with it — reported, but as a restriction question, not a leak.
VITE_APP_GOOGLE_MAPS_KEY=AIzaSyE7hM3wQ9pLv2NcT8rXbK5jY0uFd4iRoZm

# The negative control, and the reason the exemption is not allowed to key on the
# name `apiKey` or on the credential type alone: the same Google key format, in
# the same committed .env, under a name the build tool does not publish. This one
# is a real leak and must keep firing at full severity — including against this
# repository, whose own pre-commit gate reported it. The marker below dismisses
# it HERE, on the receipt, with a reason; it does not remove the finding, and the
# acceptance test still asserts CRITICAL.
# codetruss-ignore: fabricated key, never issued; this fixture exists to prove the analyzer still reports it
MAPS_SERVER_KEY=AIzaSyB4nW7kQ2xTv8LpR6cYhF1mJ0dGs5aEuOz
